# DOOM Enhanced Configuration
# Copy this file to .env and configure your variables

# Voice Settings
VOICE_SPEED=180
VOICE_VOLUME=0.9
VOICE_TYPE=male

# AI Local Engine Settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Web Search Settings
SEARCH_CACHE_DURATION=300
MAX_SEARCH_RESULTS=3

# System & Persona & Workstation Preferences
USER_NAME=Sujal
ASSISTANT_NAME=DOOM
PREFERRED_IDE=antigravity
LISTENING_TIMEOUT=10

# PostgreSQL (Dashboard & Audit DB)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Doom
DB_SSLMODE=disable

# 🌍 Multilingual Support
# STT Language codes: en-US, hi-IN, mr-IN, ta-IN, te-IN, kn-IN, ml-IN, gu-IN, bn-IN, pa-IN, ur-IN
STT_LANGUAGE=en-US
TTS_LANGUAGE=en
TTS_VOICE_EN=en-GB-RyanNeural
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_MR=mr-IN-AarohiNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
TTS_VOICE_TE=te-IN-MohanNeural
TTS_VOICE_KN=kn-IN-GaganNeural
TTS_VOICE_ML=ml-IN-MidhunNeural
TTS_VOICE_GU=gu-IN-DhwaniNeural
TTS_VOICE_BN=bn-IN-TanishaaNeural
TTS_VOICE_PA=pa-IN-GaganNeural
TTS_VOICE_UR=ur-IN-AsadNeural
AUTO_DETECT_LANGUAGE=false

# ⚡ Groq Cloud (Ultra-Fast @ 500 tokens/sec)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 🧠 OpenAI GPT-4o Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# ☁️ Amazon Bedrock (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_BEDROCK_REGION=ap-south-1
AWS_BEDROCK_REGION_FALLBACK=ap-southeast-1
BEDROCK_PRIMARY_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FAST_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_CODING_MODEL=anthropic.claude-sonnet-4-6

# 🚀 NVIDIA NIM (Nemotron 3 Ultra, Llama 3.1)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# 🗣️ Voice Cloning (Optional)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
